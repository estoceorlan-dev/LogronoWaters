{
  "name": "water-refilling-station",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch scripts/dev-api.js\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node --watch scripts/dev-api.js",
    "db:migrate": "node scripts/migrate.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "verify:neon": "node scripts/verify-neon-auth.js",
    "check": "npm run lint && npm test && npm run build",
    "format": "prettier --write src server api scripts tests *.js *.json *.ts *.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.4",
    "@neon/env": "^2.1.7",
    "@vercel/functions": "^3.11.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "jose": "^6.2.18",
    "lucide-react": "^1.45.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "concurrently": "^10.0.7",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  }
}
