# Server only: pooled Neon connection. Never use a VITE_ prefix for credentials.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct connection for migrations only. Keep out of Vercel if migrating separately.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Copy the exact branch Auth Base URL from Neon; include /neondb/auth.
NEON_AUTH_BASE_URL=https://YOUR-AUTH-HOST/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR-AUTH-HOST/neondb/auth/.well-known/jwks.json
# Optional public override. Vite also reads NEON_AUTH_BASE_URL when this is unset.
# If set, it must match the server's branch.
VITE_NEON_AUTH_URL=

# Comma-separated VERIFIED email addresses. Empty lists deny all station access.
ADMIN_EMAILS=owner@example.com
STAFF_EMAILS=
